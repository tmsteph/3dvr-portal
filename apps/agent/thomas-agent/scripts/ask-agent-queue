#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG_FILE="${THREEDVR_CONFIG_FILE:-$HOME/.3dvr/config/env}"

# Reload the selected runtime config on every queue invocation. The long-lived
# worker loop calls this wrapper for each poll, so config/owner changes can take
# effect after a repository update without killing the worker that is executing
# the update.
if [ -f "$CONFIG_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  set +a
fi

NODE_BIN="${THREEDVR_NODE_BIN:-node}"
if ! command -v "$NODE_BIN" >/dev/null 2>&1; then
  echo "3DVR queue requires Node >=22.13 with node:sqlite; not found: $NODE_BIN" >&2
  exit 1
fi
if ! "$NODE_BIN" -e '
  const [major, minor] = process.versions.node.split(".").map(Number);
  if (major < 22 || (major === 22 && minor < 13)) process.exit(1);
  require("node:sqlite");
' >/dev/null 2>&1; then
  version="$($NODE_BIN --version 2>/dev/null || printf unknown)"
  echo "3DVR queue requires Node >=22.13 with node:sqlite; $NODE_BIN is $version or lacks SQLite support." >&2
  exit 1
fi

"$NODE_BIN" "$ROOT/node/agent-task-queue.js" "$@"

# The German worker's long-lived loop invokes this wrapper every poll. Keeping
# Forge dispatch here means a normal repository pull activates new Operator
# edit support immediately without restarting the tmux session that performed
# the update.
if [ "${1:-}" = "run-once" ]; then
  "$NODE_BIN" "$ROOT/node/operator-forge-worker.js" run-once
fi
