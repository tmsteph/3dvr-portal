#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG_FILE="${THREEDVR_CONFIG_FILE:-$HOME/.3dvr/config/env}"

# Reload the selected runtime config on every queue invocation. The long-lived
# worker loop calls this wrapper for each poll, so config/owner changes can take
# effect after a repository update without killing the worker that is executing
# the update.
if [ -f "$CONFIG_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  set +a
fi

node "$ROOT/node/agent-task-queue.js" "$@"

# The German worker's long-lived loop invokes this wrapper every poll. Keeping
# Forge dispatch here means a normal repository pull activates new Operator
# edit support immediately without restarting the tmux session that performed
# the update.
if [ "${1:-}" = "run-once" ]; then
  node "$ROOT/node/operator-forge-worker.js" run-once
fi
