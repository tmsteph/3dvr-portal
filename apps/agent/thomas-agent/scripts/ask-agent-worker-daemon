#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG_FILE="${THREEDVR_CONFIG_FILE:-$HOME/.3dvr/config/env}"

if [ -f "$CONFIG_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  set +a
fi

STATE_DIR="${THREEDVR_AUTOPILOT_STATE_DIR:-$ROOT/state}"
PID_FILE="$STATE_DIR/agent-worker.pid"
LOG_FILE="$STATE_DIR/agent-worker.log"
TMUX_SESSION="${THREEDVR_AGENT_WORKER_TMUX_SESSION:-3dvr-worker}"
INTERVAL_SECONDS="${THREEDVR_AGENT_WORKER_INTERVAL_SECONDS:-20}"
ROUTER_DAEMON="$SCRIPT_DIR/ask-context-task-router-daemon"
ORGANISM_DAEMON="$SCRIPT_DIR/ask-organism-sync-daemon"
SUPERVISOR_DAEMON="$SCRIPT_DIR/ask-agent-supervisor-daemon"

mkdir -p "$STATE_DIR"

is_running() {
  if command -v tmux >/dev/null 2>&1; then
    tmux has-session -t "$TMUX_SESSION" 2>/dev/null
    return $?
  fi
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
  start)
    if is_running; then
      echo "Agent worker already running in tmux session $TMUX_SESSION."
      "$ROUTER_DAEMON" start
      "$ORGANISM_DAEMON" start
      "$SUPERVISOR_DAEMON" start
      exit 0
    fi
    # tmux can retain an older environment than the invoking shell. Load the
    # selected 3DVR config inside the session so the managed worker always uses
    # the current owner alias, queue settings, and backend configuration.
    # ask-agent-queue owns Forge dispatch for run-once, so invoke the wrapper
    # exactly once per poll to avoid duplicate Forge scans/reprocessing.
    printf -v config_file_q '%q' "$CONFIG_FILE"
    worker_loop="unset THREEDVR_ENV_LOADED; export THREEDVR_CONFIG_FILE=$config_file_q; if [ -f \"\$THREEDVR_CONFIG_FILE\" ]; then set -a; . \"\$THREEDVR_CONFIG_FILE\"; set +a; fi; cd \"$ROOT\" && while true; do \"$SCRIPT_DIR/ask-agent-queue\" run-once >>\"$LOG_FILE\" 2>&1; sleep \"$INTERVAL_SECONDS\"; done"
    if command -v tmux >/dev/null 2>&1; then
      tmux new-session -d -s "$TMUX_SESSION" "$worker_loop"
      echo "Started agent worker in tmux session $TMUX_SESSION. Log: $LOG_FILE"
    else
      setsid sh -c "$worker_loop" >/dev/null 2>&1 &
      echo "$!" > "$PID_FILE"
      echo "Started agent worker (pid $!). Log: $LOG_FILE"
    fi
    "$ROUTER_DAEMON" start
    "$ORGANISM_DAEMON" start
    "$SUPERVISOR_DAEMON" start
    ;;
  stop)
    # Desired state flips to stopped before any organ is shut down, preventing
    # the supervisor from fighting an intentional `3dvr agent stop` sequence.
    "$SUPERVISOR_DAEMON" stop || true
    "$ORGANISM_DAEMON" stop || true
    "$ROUTER_DAEMON" stop || true
    if ! is_running; then
      echo "Agent worker is not running."
      rm -f "$PID_FILE"
      exit 0
    fi
    if command -v tmux >/dev/null 2>&1; then
      tmux kill-session -t "$TMUX_SESSION"
      echo "Stopped agent worker tmux session $TMUX_SESSION."
    else
      pid="$(cat "$PID_FILE")"
      kill "$pid"
      rm -f "$PID_FILE"
      echo "Stopped agent worker (pid $pid)."
    fi
    ;;
  status)
    status=0
    if is_running; then
      echo "Agent worker running in tmux session $TMUX_SESSION."
      echo "Log: $LOG_FILE"
      if [ -f "$LOG_FILE" ]; then
        echo "Recent worker log:"
        tail -n 20 "$LOG_FILE" || true
      fi
    else
      echo "Agent worker is not running."
      status=1
      if [ -f "$LOG_FILE" ]; then
        echo "Recent worker log:"
        tail -n 40 "$LOG_FILE" || true
      fi
    fi
    echo
    if ! "$ROUTER_DAEMON" status; then
      status=1
    fi
    echo
    if ! "$ORGANISM_DAEMON" status; then
      status=1
    fi
    echo
    if ! "$SUPERVISOR_DAEMON" status; then
      status=1
    fi
    exit "$status"
    ;;
  run-once)
    "$SCRIPT_DIR/ask-agent-queue" run-once "${@:2}"
    ;;
  logs)
    tail -n 40 "$LOG_FILE"
    echo
    "$ROUTER_DAEMON" logs || true
    echo
    "$ORGANISM_DAEMON" logs || true
    echo
    "$SUPERVISOR_DAEMON" logs || true
    ;;
  *)
    echo 'Usage: ask-agent-worker-daemon start|stop|status|run-once|logs'
    exit 1
    ;;
esac
