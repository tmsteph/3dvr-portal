#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [ -f "$SCRIPT_DIR/lib/platform.sh" ]; then
  source "$SCRIPT_DIR/lib/platform.sh"
fi

STATE_DIR="${THREEDVR_AUTOPILOT_STATE_DIR:-$ROOT/state}"
DESIRED_STATE_FILE="${THREEDVR_AGENT_DESIRED_STATE_FILE:-$STATE_DIR/agent-desired-state}"
PID_FILE="$STATE_DIR/agent-supervisor.pid"
LOG_FILE="$STATE_DIR/agent-supervisor.log"
TMUX_SESSION="${THREEDVR_AGENT_SUPERVISOR_TMUX_SESSION:-3dvr-supervisor}"

mkdir -p "$STATE_DIR"

is_running() {
  if command -v tmux >/dev/null 2>&1; then
    tmux has-session -t "$TMUX_SESSION" 2>/dev/null
    return $?
  fi
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
  start)
    # A pinned canary may run only its authorized task, not the supervisor's
    # inbox/outreach/router/worker restart fan-out. Reject before state writes.
    if [ -n "${THREEDVR_AGENT_WORKER_ONLY_TASK_ID:-}" ]; then
      echo 'Pinned task mode forbids supervisor startup and unrelated daemon repairs.' >&2
      exit 1
    fi
    if is_running; then
      printf '%s\n' running > "$DESIRED_STATE_FILE"
      echo "Agent supervisor already running."
      exit 0
    fi
    # A stale desired=running file is not proof of a live supervisor. Keep
    # desired stopped until startup is actually observed, and fail closed if
    # tmux or the detached process exits immediately.
    printf '%s\n' stopped > "$DESIRED_STATE_FILE"
    if command -v tmux >/dev/null 2>&1; then
      if ! tmux new-session -d -s "$TMUX_SESSION" "cd \"$ROOT\" && exec node \"$ROOT/node/agent-supervisor.js\" >>\"$LOG_FILE\" 2>&1"; then
        echo "Failed to launch agent supervisor tmux session. Inspect $LOG_FILE" >&2
        exit 1
      fi
      sleep 1
      if ! is_running; then
        echo "Agent supervisor exited during startup. Inspect $LOG_FILE" >&2
        exit 1
      fi
      printf '%s\n' running > "$DESIRED_STATE_FILE"
      echo "Started agent supervisor in tmux session $TMUX_SESSION. Log: $LOG_FILE"
    else
      setsid node "$ROOT/node/agent-supervisor.js" >>"$LOG_FILE" 2>&1 &
      echo "$!" > "$PID_FILE"
      sleep 1
      if ! is_running; then
        rm -f "$PID_FILE"
        echo "Agent supervisor exited during startup. Inspect $LOG_FILE" >&2
        exit 1
      fi
      printf '%s\n' running > "$DESIRED_STATE_FILE"
      echo "Started agent supervisor (pid $(cat "$PID_FILE")). Log: $LOG_FILE"
    fi
    ;;
  stop)
    printf '%s\n' stopped > "$DESIRED_STATE_FILE"
    if ! is_running; then
      echo "Agent supervisor is not running. Desired state: stopped."
      rm -f "$PID_FILE"
      exit 0
    fi
    if command -v tmux >/dev/null 2>&1; then
      tmux kill-session -t "$TMUX_SESSION"
      echo "Stopped agent supervisor tmux session $TMUX_SESSION."
    else
      pid="$(cat "$PID_FILE")"
      kill "$pid"
      rm -f "$PID_FILE"
      echo "Stopped agent supervisor (pid $pid)."
    fi
    ;;
  status)
    desired="$(cat "$DESIRED_STATE_FILE" 2>/dev/null || printf stopped)"
    echo "Desired state: $desired"
    if is_running; then
      echo "Agent supervisor running."
      echo "Log: $LOG_FILE"
    else
      echo "Agent supervisor is not running."
      [ "$desired" != running ] || exit 1
    fi
    ;;
  logs)
    tail -n 60 "$LOG_FILE"
    ;;
  *)
    echo 'Usage: ask-agent-supervisor-daemon start|stop|status|logs'
    exit 1
    ;;
esac
