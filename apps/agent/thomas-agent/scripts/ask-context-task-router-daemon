#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [ -f "$SCRIPT_DIR/lib/platform.sh" ]; then
  source "$SCRIPT_DIR/lib/platform.sh"
fi

STATE_DIR="${THREEDVR_AUTOPILOT_STATE_DIR:-$ROOT/state}"
PID_FILE="$STATE_DIR/context-task-router.pid"
LOG_FILE="$STATE_DIR/context-task-router.log"
TMUX_SESSION="${THREEDVR_CONTEXT_TASK_ROUTER_TMUX_SESSION:-3dvr-context-router}"

mkdir -p "$STATE_DIR"

is_running() {
  if command -v tmux >/dev/null 2>&1; then
    tmux has-session -t "$TMUX_SESSION" 2>/dev/null
    return $?
  fi
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
  start)
    if is_running; then
      echo "Context task router already running."
      exit 0
    fi
    if command -v tmux >/dev/null 2>&1; then
      tmux new-session -d -s "$TMUX_SESSION" "cd \"$ROOT\" && exec node \"$ROOT/node/context-task-router.js\" >>\"$LOG_FILE\" 2>&1"
      echo "Started Context task router in tmux session $TMUX_SESSION. Log: $LOG_FILE"
    else
      setsid node "$ROOT/node/context-task-router.js" >>"$LOG_FILE" 2>&1 &
      echo "$!" > "$PID_FILE"
      echo "Started Context task router (pid $!). Log: $LOG_FILE"
    fi
    ;;
  stop)
    if ! is_running; then
      echo "Context task router is not running."
      rm -f "$PID_FILE"
      exit 0
    fi
    if command -v tmux >/dev/null 2>&1; then
      tmux kill-session -t "$TMUX_SESSION"
      echo "Stopped Context task router tmux session $TMUX_SESSION."
    else
      pid="$(cat "$PID_FILE")"
      kill "$pid"
      rm -f "$PID_FILE"
      echo "Stopped Context task router (pid $pid)."
    fi
    ;;
  status)
    if is_running; then
      echo "Context task router running."
      echo "Log: $LOG_FILE"
    else
      echo "Context task router is not running."
      exit 1
    fi
    ;;
  logs)
    tail -n 40 "$LOG_FILE"
    ;;
  *)
    echo 'Usage: ask-context-task-router-daemon start|stop|status|logs'
    exit 1
    ;;
esac
