#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG_FILE="${THREEDVR_CONFIG_FILE:-$HOME/.3dvr/config/env}"
if [ -f "$CONFIG_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  set +a
fi
NODE_BIN="${THREEDVR_NODE_BIN:-node}"

STATE_DIR="${THREEDVR_AUTOPILOT_STATE_DIR:-$ROOT/state}"
PID_FILE="$STATE_DIR/organism-sync.pid"
LOG_FILE="$STATE_DIR/organism-sync.log"
TMUX_SESSION="${THREEDVR_ORGANISM_SYNC_TMUX_SESSION:-3dvr-organism-sync}"

mkdir -p "$STATE_DIR"

is_running() {
  if command -v tmux >/dev/null 2>&1; then
    tmux has-session -t "$TMUX_SESSION" 2>/dev/null
    return $?
  fi
  [ -f "$PID_FILE" ] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
  start)
    if is_running; then
      echo "Organism sync already running."
      exit 0
    fi
    printf -v config_file_q '%q' "$CONFIG_FILE"
    sync_command="export THREEDVR_CONFIG_FILE=$config_file_q; if [ -f \"\$THREEDVR_CONFIG_FILE\" ]; then set -a; . \"\$THREEDVR_CONFIG_FILE\"; set +a; fi; exec \"\${THREEDVR_NODE_BIN:-node}\" \"$ROOT/node/organism-sync.js\" >>\"$LOG_FILE\" 2>&1"
    if command -v tmux >/dev/null 2>&1; then
      tmux new-session -d -s "$TMUX_SESSION" "cd \"$ROOT\" && $sync_command"
      echo "Started Organism sync in tmux session $TMUX_SESSION. Log: $LOG_FILE"
    else
      setsid sh -c "cd \"$ROOT\" && $sync_command" &
      echo "$!" > "$PID_FILE"
      echo "Started Organism sync (pid $!). Log: $LOG_FILE"
    fi
    ;;
  stop)
    if ! is_running; then
      echo "Organism sync is not running."
      rm -f "$PID_FILE"
      exit 0
    fi
    if command -v tmux >/dev/null 2>&1; then
      tmux kill-session -t "$TMUX_SESSION"
      echo "Stopped Organism sync tmux session $TMUX_SESSION."
    else
      pid="$(cat "$PID_FILE")"
      kill "$pid"
      rm -f "$PID_FILE"
      echo "Stopped Organism sync (pid $pid)."
    fi
    ;;
  status)
    if is_running; then
      echo "Organism sync running."
      echo "Log: $LOG_FILE"
    else
      echo "Organism sync is not running."
      exit 1
    fi
    ;;
  run-now)
    exec "$NODE_BIN" "$ROOT/node/organism-sync.js" --once
    ;;
  logs)
    tail -n 40 "$LOG_FILE"
    ;;
  *)
    echo 'Usage: ask-organism-sync-daemon start|stop|status|run-now|logs'
    exit 1
    ;;
esac
