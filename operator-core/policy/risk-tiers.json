{"$id":"https://3dvr.tech/policy/operator/risk-tiers/v1","description":"Risk classification. The model proposes; the policy engine decides. Pure functions only — no I/O.","tiers":{"R0":{"default_handling":"allow_within_active_task","examples":["read battery level","list files in workspace","inspect UI tree","read job status"],"label":"Observe"},"R1":{"default_handling":"allow_plus_receipt","examples":["open app","create draft","move file within workspace","capture screenshot (task workspace)"],"label":"Reversible"},"R2":{"default_handling":"fresh_approval_required","examples":["send message","post content","change remote state","write outside task workspace"],"label":"External"},"R3":{"default_handling":"approval_plus_visible_indicator","examples":["read private screen content","use microphone/camera","install APK","access credentials"],"label":"Sensitive"},"R4":{"default_handling":"step_up_approval_narrow_allowlist","examples":["delete data","factory reset","privilege change","security setting change"],"label":"Destructive"}}}