{"$id":"https://3dvr.tech/schemas/operator/receipt/v1","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"Immutable, hash-chained evidence of one action attempt. Redacted before storage.","properties":{"action_id":{"type":"string"},"after_state_hash":{"type":"string"},"args_redacted":{"description":"Args with sensitive fields replaced by [REDACTED].","type":"object"},"before_state_hash":{"type":"string"},"chain_hash":{"description":"SHA-256(prev_chain_hash + canonical receipt). Tamper-evident append-only chain per job.","type":"string"},"device_id":{"type":"string"},"executor_version":{"type":"string"},"finished_at":{"format":"date-time","type":"string"},"job_id":{"type":"string"},"outcome":{"enum":["success","denied","failed","duplicate_suppressed"],"type":"string"},"prev_chain_hash":{"type":["string","null"]},"reason_code":{"type":"string"},"receipt_id":{"pattern":"^rcpt_[A-Za-z0-9_-]+$","type":"string"},"started_at":{"format":"date-time","type":"string"}},"required":["receipt_id","action_id","job_id","device_id","started_at","finished_at","outcome","executor_version","chain_hash"],"title":"Operator Action Receipt","type":"object"}