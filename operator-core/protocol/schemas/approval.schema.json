{"$id":"https://3dvr.tech/schemas/operator/approval/v1","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"Human approval bound to the exact hash of the action envelope it authorizes. Prevents approval substitution.","properties":{"action_hash":{"description":"SHA-256 of the canonical action envelope (minus signature). Approval is valid ONLY for this exact action.","type":"string"},"approval_id":{"pattern":"^apr_[A-Za-z0-9_-]+$","type":"string"},"decided_at":{"format":"date-time","type":"string"},"decided_by":{"description":"Owner identity that decided.","type":"string"},"decision":{"enum":["approved","denied"],"type":"string"},"expires_at":{"format":"date-time","type":"string"},"job_id":{"pattern":"^job_[A-Za-z0-9_-]+$","type":"string"},"scope_note":{"type":"string"}},"required":["approval_id","action_hash","job_id","decided_at","decision","expires_at"],"title":"Operator Approval","type":"object"}