[Unit]
Description=3DVR Secrets Broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=threedvr-secrets
Group=threedvr-agents
SupplementaryGroups=threedvr-secrets
Environment=NODE_ENV=production
Environment=THREEDVR_CONTROL_NODE=ovh
Environment=THREEDVR_SECRETS_BROKER_SOCKET=/run/3dvr-secrets-broker/broker.sock
Environment=THREEDVR_SECRETS_BROKER_POLICY=/etc/3dvr/secrets-broker/policy.json
Environment=THREEDVR_SECRETS_BROKER_AGENTS=/etc/3dvr/secrets-broker/agents.json
Environment=THREEDVR_SECRETS_BROKER_APPROVALS=/var/lib/3dvr-secrets-broker/approvals.json
Environment=THREEDVR_SECRETS_BROKER_AUDIT=/var/lib/3dvr-secrets-broker/audit.jsonl
Environment=THREEDVR_SECRETS_BROKER_AUDIT_KEY=/var/lib/3dvr-secrets-broker/audit.key
EnvironmentFile=-/etc/3dvr/secrets-broker/bitwarden.env
ExecStart=/usr/bin/node /opt/3dvr/secrets-broker/secrets-broker-server.js
Restart=on-failure
RestartSec=3
RuntimeDirectory=3dvr-secrets-broker
RuntimeDirectoryMode=0750
StateDirectory=3dvr-secrets-broker
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
