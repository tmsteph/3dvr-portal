{
  "version": 1,
  "defaults": {
    "approval": "always",
    "leaseSeconds": 300,
    "maxUses": 1
  },
  "backends": {
    "bitwarden": {
      "type": "bitwarden-secrets-manager",
      "binary": "/usr/local/bin/bws",
      "timeoutMs": 15000
    },
    "openbao": {
      "type": "openbao-kv"
    }
  },
  "secrets": {
    "iatse.username": {
      "backend": "bitwarden",
      "locator": {
        "projectName": "3dvr Agent",
        "key": "IATSE_PORTAL_USERNAME"
      },
      "capability": "secret.read",
      "scopes": [
        "site:iatse"
      ],
      "approval": {
        "mode": "auto"
      }
    },
    "iatse.password": {
      "backend": "bitwarden",
      "locator": {
        "projectName": "3dvr Agent",
        "key": "IATSE_PORTAL_PASSWORD"
      },
      "capability": "secret.read",
      "scopes": [
        "site:iatse"
      ],
      "approval": {
        "mode": "auto"
      }
    },
    "vault.index": {
      "backend": "bitwarden",
      "locator": {
        "projectName": "3dvr Agent",
        "key": "VAULT_INDEX"
      },
      "capability": "secret.read",
      "scopes": [
        "secrets:password-manager-mirror"
      ],
      "approval": {
        "mode": "auto"
      }
    },
    "vault.item.*": {
      "backend": "bitwarden",
      "locator": {
        "projectName": "3dvr Agent",
        "keyFromAliasPrefix": "vault.item."
      },
      "capability": "secret.read",
      "scopes": [
        "secrets:password-manager-mirror"
      ],
      "approval": {
        "mode": "auto"
      }
    },
    "google.oauth.3dvr": {
      "backend": "openbao",
      "locator": {
        "key": "GOOGLE_OAUTH_3DVR"
      },
      "capability": "secret.read",
      "scopes": [
        "secrets:google-oauth"
      ],
      "approval": {
        "mode": "auto"
      }
    },
    "google.oauth.tmsteph": {
      "backend": "openbao",
      "locator": {
        "key": "GOOGLE_OAUTH_TMSTEPH"
      },
      "capability": "secret.read",
      "scopes": [
        "secrets:google-oauth"
      ],
      "approval": {
        "mode": "auto"
      }
    },
    "google.vault.3dvr": {
      "backend": "openbao",
      "locator": {
        "key": "google-oauth:acct_google_REPLACE_WITH_ACCOUNT_ID"
      },
      "capability": "secret.read",
      "scopes": [
        "secrets:google-oauth"
      ],
      "approval": {
        "mode": "auto"
      },
      "write": {
        "capability": "secret.write",
        "scopes": [
          "secrets:google-oauth"
        ],
        "approval": {
          "mode": "auto"
        },
        "projectName": "google-oauth-vault"
      }
    }
  }
}
