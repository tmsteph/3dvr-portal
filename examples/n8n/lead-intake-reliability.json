      "name": "Acknowledge Duplicate",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [250, 80]
    },
    {
      "parameters": {
        "jsCode": "const lead = $json.lead;\nconst inServiceArea = ['NC', 'SC'].includes(lead.state);\nreturn [{ json: { ...$json, route: inServiceArea ? 'review' : 'out_of_area', crmMutation: { operation: 'upsert', externalId: lead.leadId, fields: { email: lead.email, state: lead.state, source: lead.source, route: inServiceArea ? 'review' : 'out_of_area' } } } }];"
      },
      "id": "0b8f6c9a-2d91-4a50-a4ab-2d94ceef0777",
      "name": "Prepare CRM Mutation",
