{
  "name": "3DVR Lead Intake Reliability Demo",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "3dvr-lead-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "0b8f6c9a-2d91-4a50-a4ab-2d94ceef0111",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-700, 0]
    },
    {
      "parameters": {
        "jsCode": "const source = $input.first().json.body ?? $input.first().json;\nconst leadId = String(source.leadId ?? '').trim();\nconst email = String(source.email ?? '').trim().toLowerCase();\nconst state = String(source.state ?? '').trim().toUpperCase();\nconst channel = String(source.source ?? 'unknown').trim();\nconst errors = [];\nif (!leadId) errors.push('leadId is required');\nif (!email || !email.includes('@')) errors.push('valid email is required');\nif (state && !/^[A-Z]{2}$/.test(state)) errors.push('state must be a two-letter code');\nif (errors.length) return [{ json: { ok: false, status: 'invalid', errors } }];\nconst store = $getWorkflowStaticData('global');\nstore.seen ??= {};\nconst now = Date.now();\nconst ttlMs = 24 * 60 * 60 * 1000;\nfor (const [key, seenAt] of Object.entries(store.seen)) { if (now - Number(seenAt) > ttlMs) delete store.seen[key]; }\nconst idempotencyKey = `lead:${leadId}`;\nconst duplicate = Boolean(store.seen[idempotencyKey]);\nif (!duplicate) store.seen[idempotencyKey] = now;\nreturn [{ json: { ok: true, status: duplicate ? 'duplicate' : 'accepted', duplicate, idempotencyKey, lead: { leadId, email, state, source: channel } } }];"
      },
      "id": "0b8f6c9a-2d91-4a50-a4ab-2d94ceef0222",
      "name": "Validate + Dedupe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-480, 0]
    },
