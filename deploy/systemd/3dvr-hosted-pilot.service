[Unit]
Description=3DVR Hosted Operator pilot bounded worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/3dvr/hosted-operator-pilot.env

[Service]
Type=oneshot
User=3dvr-hosted-pilot
Group=3dvr-hosted-pilot
EnvironmentFile=/etc/3dvr/hosted-operator-pilot.env
WorkingDirectory=/opt/3dvr-portal-production/current
ExecStart=/usr/bin/node scripts/hosted-operator-worker.mjs
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/3dvr-hosted-pilot
UMask=0077
